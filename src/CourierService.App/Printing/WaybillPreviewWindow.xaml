<Window x:Class="CourierService.App.Printing.WaybillPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="900" MinWidth="520" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20,14,20,16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="_Закрити" IsCancel="True" MinWidth="110" />
            <Button DockPanel.Dock="Right" Content="_Друкувати…" IsDefault="True" MinWidth="130" Margin="0,0,8,0"
                    Click="OnPrintClick" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="Формат A5. Щоб зберегти PDF, оберіть принтер «Microsoft Print to PDF»." />
        </DockPanel>
        <DocumentViewer x:Name="Viewer" AutomationProperties.Name="Перегляд накладної" />
    </DockPanel>
</Window>
