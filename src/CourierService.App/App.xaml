<Application x:Class="CourierService.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CourierService.App.ViewModels"
             xmlns:views="clr-namespace:CourierService.App.Views"
             xmlns:converters="clr-namespace:CourierService.App.Converters"
             xmlns:dir="clr-namespace:CourierService.App.ViewModels.Directories"
             xmlns:dirViews="clr-namespace:CourierService.App.Views.Directories"
             xmlns:orders="clr-namespace:CourierService.App.ViewModels.Orders"
             xmlns:orderViews="clr-namespace:CourierService.App.Views.Orders"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="Light">
    <!-- StartupUri не використовується: вікно входу й головне вікно відкриває App.OnStartup.
         OnExplicitShutdown: закриття вікна входу не завершує програму, завершення — лише явним викликом.
         ThemeMode="Light" вмикає вбудовану Fluent-тему WPF (рішення D-16). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:SectionVisibilityConverter x:Key="SectionVisibility" />
            <converters:VisibleWhenConverter x:Key="VisibleWhen" />
            <converters:EnumDisplayConverter x:Key="EnumDisplay" />
            <converters:CoefficientConverter x:Key="Coefficient" />
            <converters:KilogramsConverter x:Key="Kilograms" />
            <converters:PhoneConverter x:Key="Phone" />

            <!-- Відповідність «ViewModel → View»: WPF сам обирає вигляд сторінки за типом ViewModel -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <views:PlaceholderView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HelpViewModel}">
                <views:HelpView />
            </DataTemplate>

            <!-- Довідники: сторінки зі списком і поля форм у спільному вікні редагування -->
            <DataTemplate DataType="{x:Type dir:ZonesViewModel}">
                <dirViews:ZonesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dir:ZoneEditorViewModel}">
                <dirViews:ZoneEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dir:TariffsViewModel}">
                <dirViews:TariffsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dir:TariffEditorViewModel}">
                <dirViews:TariffEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dir:ClientsViewModel}">
                <dirViews:ClientsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dir:ClientEditorViewModel}">
                <dirViews:ClientEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dir:CouriersViewModel}">
                <dirViews:CouriersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dir:CourierEditorViewModel}">
                <dirViews:CourierEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dir:UsersViewModel}">
                <dirViews:UsersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dir:UserEditorViewModel}">
                <dirViews:UserEditorView />
            </DataTemplate>

            <!-- Замовлення: форма нового замовлення у спільному вікні редагування, список і пошук — сторінки -->
            <DataTemplate DataType="{x:Type orders:OrderEditorViewModel}">
                <orderViews:OrderEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type orders:OrderListViewModel}">
                <orderViews:OrderListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type orders:TrackingSearchViewModel}">
                <orderViews:TrackingSearchView />
            </DataTemplate>
            <!-- Мої доставки: один шаблон для базового класу активних і виконаних -->
            <DataTemplate DataType="{x:Type orders:MyDeliveriesViewModelBase}">
                <orderViews:MyDeliveriesView />
            </DataTemplate>
            <!-- Дії з картки замовлення, що потребують введення (D-25) -->
            <DataTemplate DataType="{x:Type orders:AssignCourierViewModel}">
                <orderViews:AssignCourierView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type orders:FailureReasonViewModel}">
                <orderViews:FailureReasonView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
