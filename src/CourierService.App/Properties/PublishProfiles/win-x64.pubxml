<?xml version="1.0" encoding="utf-8"?>
<!--
  Публікація для здачі (D-38): один самодостатній exe для Windows 10/11 x64.
  .NET на цільовому ПК не потрібен; рідні бібліотеки SQLite і SkiaSharp упаковано всередину exe.
  Команда: dotnet publish src/CourierService.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Рідні .dll (e_sqlite3, libSkiaSharp) розпаковуються з exe під час першого запуску -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Стиснення зменшує exe приблизно вдвічі ціною трохи довшого запуску -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Обрізання коду WPF не підтримує -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- У теці публікації лише exe: без файлів налагодження й XML-документації -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
