<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Власні доповнення до Fluent-теми (рішення D-16): типографіка й відступи сторінок -->

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,12,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="Foreground" Value="#C42B1C" />
    </Style>

    <!-- Помилка біля поля: червона рамка й текст першої помилки під полем (INotifyDataErrorInfo) -->
    <!-- Ширина тексту дорівнює ширині поля: у вузькому полі текст переноситься, а не заходить на сусідні поля
         й не розтягує червону рамку -->
    <ControlTemplate x:Key="FieldErrorTemplate">
        <StackPanel>
            <Border BorderBrush="#C42B1C" BorderThickness="1" CornerRadius="4">
                <AdornedElementPlaceholder x:Name="Field" />
            </Border>
            <TextBlock Text="{Binding [0].ErrorContent}"
                       Foreground="#C42B1C" FontSize="12" TextWrapping="Wrap"
                       Width="{Binding AdornedElement.ActualWidth, ElementName=Field}"
                       HorizontalAlignment="Left" Margin="2,2,0,0" />
        </StackPanel>
    </ControlTemplate>

    <!-- Поля форм: місце під текст помилки зарезервовано відступом знизу. Текст помилки шаблон малює
         в окремому шарі, якого не бачать екранні диктори, тому помилка дублюється в HelpText поля -->
    <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource FieldErrorTemplate}" />
        <Setter Property="Margin" Value="0,0,0,26" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="AutomationProperties.HelpText"
                        Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FormComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource FieldErrorTemplate}" />
        <Setter Property="Margin" Value="0,0,0,26" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="AutomationProperties.HelpText"
                        Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Меню правої кнопки для тексту, який можна лише виділити й скопіювати (x:Shared: окреме меню для кожного поля) -->
    <ContextMenu x:Key="ReadOnlyTextMenu" x:Shared="False">
        <MenuItem Header="_Копіювати" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
        <MenuItem Header="Виділити _все" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" />
    </ContextMenu>

    <!-- Текст, який виглядає як звичайний, але його можна виділити мишкою й скопіювати (трек-номер, повідомлення).
         Ім'я для екранних дикторів — сам текст -->
    <Style x:Key="SelectableTextStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="ContextMenu" Value="{StaticResource ReadOnlyTextMenu}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Маленька кнопка зі значком «копіювати» поруч із трек-номером -->
    <Style x:Key="CopyButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Content" Value="&#xE8C8;" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="Копіювати трек-номер" />
        <Setter Property="AutomationProperties.Name" Value="Копіювати трек-номер" />
    </Style>

    <!-- Вузькі поля (габарити, вага): помилка може зайняти два рядки -->
    <Style x:Key="NarrowFormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
        <Setter Property="Margin" Value="0,0,0,42" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Підказка ставиться між підписом і полем: під полем місце зарезервоване для тексту помилки -->
    <Style x:Key="HintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Таблиці довідників: неактивні записи — сірі -->
    <Style x:Key="DirectoryRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DirectoryGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowStyle" Value="{StaticResource DirectoryRowStyle}" />
    </Style>

    <!-- Термін доставки (D-31): колір фону — завжди разом із текстом, щоб стан було видно не лише кольором.
         DataContext позначки — SlaResult. -->
    <Style x:Key="SlaBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="OnTime">
                <Setter Property="Background" Value="#DFF6DD" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="AtRisk">
                <Setter Property="Background" Value="#FFF1C2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Overdue">
                <Setter Property="Background" Value="#FDE0E2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="SlaCellTemplate">
        <Border DataContext="{Binding Sla}" Style="{StaticResource SlaBadgeStyle}" Margin="2,1">
            <TextBlock Text="{Binding Text}" />
        </Border>
    </DataTemplate>

    <!-- Відступ робочої області сторінки -->
    <Thickness x:Key="PagePadding">32,24,32,24</Thickness>
</ResourceDictionary>
