<Window x:Class="CourierService.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CourierService.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="32,28">
        <TextBlock Text="Кур'єрська служба" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,4" />
        <TextBlock Text="Увійдіть, щоб продовжити" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,20" />

        <Label Content="_Логін" Target="{Binding ElementName=LoginBox}" Padding="0,0,0,4" />
        <TextBox x:Name="LoginBox"
                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="50"
                 Margin="0,0,0,12" />

        <Label Content="_Пароль" Target="{Binding ElementName=PasswordBox}" Padding="0,0,0,4" />
        <PasswordBox x:Name="PasswordBox"
                     MaxLength="100"
                     PasswordChanged="OnPasswordChanged"
                     Margin="0,0,0,12" />

        <TextBlock Text="{Binding StatusMessage}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource VisibleWhen}}"
                   Style="{StaticResource SecondaryTextStyle}"
                   Margin="0,0,0,8" />
        <TextBlock Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}"
                   Style="{StaticResource ErrorTextStyle}"
                   Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="_Увійти" IsDefault="True" MinWidth="110" Margin="0,0,8,0"
                    Command="{Binding SignInCommand}" />
            <Button Content="_Вихід" IsCancel="True" MinWidth="110" />
        </StackPanel>

        <Expander Header="Демонстраційні облікові записи" Margin="0,20,0,0">
            <ItemsControl ItemsSource="{Binding DemoAccountHints}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DemoAccountHint}">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,2">
                            <Run Text="{Binding Role, Mode=OneWay}" /><Run Text=": " />
                            <Run Text="{Binding Login, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" / " />
                            <Run Text="{Binding Password, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>
    </StackPanel>
</Window>
