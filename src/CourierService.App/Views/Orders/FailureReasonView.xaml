<UserControl x:Class="CourierService.App.Views.Orders.FailureReasonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:CourierService.App.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:orders="clr-namespace:CourierService.App.ViewModels.Orders"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=orders:FailureReasonViewModel}">
    <StackPanel>
        <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8">
            <Run Text="Замовлення" /> <Run Text="{Binding TrackingNumber, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Text="Типові причини" Style="{StaticResource FieldLabelStyle}" />
        <ItemsControl ItemsSource="{Binding TypicalReasons}" Focusable="False" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding}" Margin="0,0,6,6" Padding="10,4"
                            Command="{Binding DataContext.UseReasonCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Причина (обов'язково)" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64"
                 Style="{StaticResource FormTextBoxStyle}" b:Hint.Text="Опишіть, що сталося, або оберіть типову причину вище" AutomationProperties.Name="Причина" />
    </StackPanel>
</UserControl>
