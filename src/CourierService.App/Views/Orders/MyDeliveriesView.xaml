<UserControl x:Class="CourierService.App.Views.Orders.MyDeliveriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:orders="clr-namespace:CourierService.App.ViewModels.Orders"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=orders:MyDeliveriesViewModelBase}">
    <!-- Один вигляд для активних і виконаних доставок: WPF обирає шаблон за базовим типом ViewModel -->
    <DockPanel Margin="{StaticResource PagePadding}">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="_Оновити" MinWidth="100" Margin="0,0,8,0" Command="{Binding LoadCommand}" />
                <Button Content="_Відкрити" MinWidth="110" Command="{Binding OpenOrderCommand}"
                        ToolTip="Картка доставки: «Забрав», «Доставив», «Невдала спроба» (або подвійний клік)" />
            </StackPanel>
            <TextBlock Text="Подвійний клік по рядку відкриває картку з діями." Style="{StaticResource SecondaryTextStyle}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8"
                   Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding CountText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" />

        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedOrder}" Style="{StaticResource DirectoryGridStyle}"
                  RowStyle="{StaticResource {x:Type DataGridRow}}" AutomationProperties.Name="Доставки">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenOrderCommand}" />
                <KeyBinding Key="Enter" Command="{Binding OpenOrderCommand}" />
                <!-- Ctrl+C копіює саме трек-номер, а не весь рядок таблиці -->
                <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyTrackingNumberCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="_Відкрити картку" Command="{Binding OpenOrderCommand}" InputGestureText="Enter" />
                    <MenuItem Header="_Копіювати трек-номер" Command="{Binding CopyTrackingNumberCommand}" InputGestureText="Ctrl+C" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Трек-номер" Binding="{Binding TrackingNumber}" Width="Auto" />
                <DataGridTextColumn Header="Статус" Binding="{Binding Status, Converter={StaticResource EnumDisplay}}" Width="Auto" />
                <DataGridTextColumn Header="Доставити до" Binding="{Binding Deadline, StringFormat=dd.MM.yyyy HH:mm}" Width="Auto" />
                <DataGridTemplateColumn Header="Термін" CellTemplate="{StaticResource SlaCellTemplate}" SortMemberPath="Sla.State" Width="190" />
                <!-- Кур'єру головне — куди їхати: адреса крупно, район і контакт дрібніше в тій самій клітинці -->
                <DataGridTemplateColumn Header="Звідки забрати" SortMemberPath="PickupAddress" Width="*" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,3">
                                <TextBlock Text="{Binding PickupAddress}" TextWrapping="Wrap" />
                                <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap">
                                    <Run Text="{Binding PickupZone, Mode=OneWay}" /> · <Run Text="{Binding ClientName, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Куди доставити" SortMemberPath="DeliveryAddress" Width="*" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,3">
                                <TextBlock Text="{Binding DeliveryAddress}" TextWrapping="Wrap" />
                                <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap">
                                    <Run Text="{Binding DeliveryZone, Mode=OneWay}" /> · <Run Text="{Binding RecipientName, Mode=OneWay}" />,
                                    <Run Text="{Binding RecipientPhone, Mode=OneWay, Converter={StaticResource Phone}}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Вартість" Binding="{Binding Price}" SortMemberPath="Price.Kopecks" Width="Auto" />
                <DataGridTextColumn Header="Платить" Binding="{Binding Payer, Converter={StaticResource EnumDisplay}}" Width="Auto" />
                <DataGridTextColumn Header="Оплата" Binding="{Binding PaymentStatus, Converter={StaticResource EnumDisplay}}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
