<UserControl x:Class="CourierService.App.Views.Orders.TrackingSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:orders="clr-namespace:CourierService.App.ViewModels.Orders"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=orders:TrackingSearchViewModel}">
    <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />

        <TextBlock Text="Трек-номер" Style="{StaticResource FieldLabelStyle}" />
        <TextBlock Text="Регістр літер, пробіли й дефіси не важать; літери KV можна не вводити."
                   Style="{StaticResource HintTextStyle}" />
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding TrackingNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"
                     AutomationProperties.Name="Трек-номер" Loaded="OnSearchBoxLoaded">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="_Знайти" MinWidth="110" Margin="8,0,0,0" Command="{Binding SearchCommand}" />
        </Grid>

        <TextBlock Text="{Binding Notice}" Style="{StaticResource ErrorTextStyle}"
                   Visibility="{Binding Notice, Converter={StaticResource VisibleWhen}}" />

        <!-- Картка знайденого замовлення -->
        <Border Visibility="{Binding Result, Converter={StaticResource VisibleWhen}}"
                Background="#F3F6FA" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="20,16"
                AutomationProperties.Name="Знайдене замовлення">
            <Grid DataContext="{Binding Result}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                        <Setter Property="Margin" Value="0,2,16,2" />
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding TrackingNumber}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Text="Статус" Opacity="0.7" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status, Converter={StaticResource EnumDisplay}}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Text="Оформлено" Opacity="0.7" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" />
                <TextBlock Grid.Row="3" Text="Відправник" Opacity="0.7" />
                <TextBlock Grid.Row="3" Grid.Column="1">
                    <Run Text="{Binding ClientName, Mode=OneWay}" />, <Run Text="{Binding ClientPhone, Mode=OneWay, Converter={StaticResource Phone}}" />
                </TextBlock>
                <TextBlock Grid.Row="4" Text="Одержувач" Opacity="0.7" />
                <TextBlock Grid.Row="4" Grid.Column="1">
                    <Run Text="{Binding RecipientName, Mode=OneWay}" />, <Run Text="{Binding RecipientPhone, Mode=OneWay, Converter={StaticResource Phone}}" />
                </TextBlock>
                <TextBlock Grid.Row="5" Text="Маршрут" Opacity="0.7" />
                <TextBlock Grid.Row="5" Grid.Column="1">
                    <Run Text="{Binding PickupZone, Mode=OneWay}" /> → <Run Text="{Binding DeliveryZone, Mode=OneWay}" />, тариф «<Run Text="{Binding TariffName, Mode=OneWay}" />»
                </TextBlock>
                <TextBlock Grid.Row="6" Text="Вартість" Opacity="0.7" />
                <TextBlock Grid.Row="6" Grid.Column="1">
                    <Run Text="{Binding Price, Mode=OneWay}" />; платник: <Run Text="{Binding Payer, Mode=OneWay, Converter={StaticResource EnumDisplay}}" />
                    (<Run Text="{Binding PaymentMethod, Mode=OneWay, Converter={StaticResource EnumDisplay}}" />), оплата: <Run Text="{Binding PaymentStatus, Mode=OneWay, Converter={StaticResource EnumDisplay}}" />
                </TextBlock>
                <TextBlock Grid.Row="7" Text="Кур'єр" Opacity="0.7" />
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CourierName, TargetNullValue='ще не призначено'}" />
                <TextBlock Grid.Row="8" Text="Доставити до" Opacity="0.7" />
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Deadline, StringFormat=dd.MM.yyyy HH:mm}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
