<Window x:Class="CourierService.App.Views.Orders.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:orders="clr-namespace:CourierService.App.ViewModels.Orders"
        xmlns:core="clr-namespace:CourierService.Core.Orders;assembly=CourierService.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=orders:OrderDetailsViewModel}"
        Title="{Binding Title}"
        Width="940" SizeToContent="Height" MaxHeight="860"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#F3F6FA" />
            <Setter Property="BorderBrush" Value="#D8DEE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,2,16,2" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="28,20,28,20">
        <!-- Дії над замовленням (D-25): лише ті, що дозволяє OrderWorkflow для цієї ролі й статусу -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="_Закрити" IsCancel="True" MinWidth="110" />
                <Button DockPanel.Dock="Right" Content="Друк _накладної…" MinWidth="150" Margin="0,0,8,6"
                        Command="{Binding PrintWaybillCommand}"
                        Visibility="{Binding CanPrintWaybill, Converter={StaticResource VisibleWhen}}"
                        ToolTip="Перегляд і друк накладної з QR-кодом трек-номера" />
                <ItemsControl ItemsSource="{Binding Actions}" Focusable="False" AutomationProperties.Name="Дії">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:OrderActionOption}">
                            <Button Content="{Binding Title}" Margin="0,0,8,6" Padding="14,6"
                                    IsEnabled="{Binding IsEnabled}"
                                    ToolTip="{Binding BlockedReason}" ToolTipService.ShowOnDisabled="True"
                                    Command="{Binding DataContext.ExecuteActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </StackPanel>

        <!-- Заголовок: трек-номер, статус, терміни -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <!-- Трек-номер можна виділити мишкою або скопіювати кнопкою -->
                <TextBox Text="{Binding Order.TrackingNumber, Mode=OneWay}" Style="{StaticResource SelectableTextStyle}"
                         FontSize="24" FontWeight="SemiBold" TextWrapping="NoWrap" VerticalAlignment="Center" />
                <Button Style="{StaticResource CopyButtonStyle}" Command="{Binding CopyTrackingNumberCommand}" Margin="8,0,0,0" />
                <TextBlock Text="Скопійовано" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Visibility="{Binding IsTrackingNumberCopied, Converter={StaticResource VisibleWhen}}" />
                <Border Width="16" />
                <Border Background="#E6EEF8" CornerRadius="12" Padding="12,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Order.Status, Converter={StaticResource EnumDisplay}}" FontWeight="SemiBold"
                               AutomationProperties.Name="Статус" />
                </Border>
                <Border DataContext="{Binding Sla}" Style="{StaticResource SlaBadgeStyle}" Padding="12,3" Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Text}" AutomationProperties.Name="Термін" />
                </Border>
            </StackPanel>
            <TextBlock Text="{Binding DatesText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />

            <!-- Інформаційні рядки: що бракує для наступного кроку (наприклад, оплати відправника) -->
            <ItemsControl ItemsSource="{Binding Actions}" Focusable="False" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:OrderActionOption}">
                        <TextBlock Text="{Binding BlockedReason}" Style="{StaticResource ErrorTextStyle}" Margin="0,0,0,4"
                                   Visibility="{Binding BlockedReason, Converter={StaticResource VisibleWhen}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="Маршрут" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Grid.Row="1" Text="Відправник" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueStyle}">
                                    <Run Text="{Binding Order.Client.Name, Mode=OneWay}" />, <Run Text="{Binding Order.Client.Phone, Mode=OneWay, Converter={StaticResource Phone}}" />
                                </TextBlock>
                                <TextBlock Grid.Row="2" Text="Звідки" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueStyle}">
                                    <Run Text="{Binding Order.PickupAddress, Mode=OneWay}" /> (<Run Text="{Binding Order.PickupZone.Name, Mode=OneWay}" />)
                                </TextBlock>
                                <TextBlock Grid.Row="3" Text="Одержувач" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueStyle}">
                                    <Run Text="{Binding Order.RecipientName, Mode=OneWay}" />, <Run Text="{Binding Order.RecipientPhone, Mode=OneWay, Converter={StaticResource Phone}}" />
                                </TextBlock>
                                <TextBlock Grid.Row="4" Text="Куди" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueStyle}">
                                    <Run Text="{Binding Order.DeliveryAddress, Mode=OneWay}" /> (<Run Text="{Binding Order.DeliveryZone.Name, Mode=OneWay}" />)
                                </TextBlock>
                                <TextBlock Grid.Row="5" Text="Посилка" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueStyle}">
                                    <Run Text="{Binding Order.WeightGrams, Mode=OneWay, Converter={StaticResource Kilograms}}" />,
                                    <Run Text="{Binding Order.LengthCm, Mode=OneWay}" />×<Run Text="{Binding Order.WidthCm, Mode=OneWay}" />×<Run Text="{Binding Order.HeightCm, Mode=OneWay}" /> см,
                                    тариф «<Run Text="{Binding Order.Tariff.Name, Mode=OneWay}" />»
                                </TextBlock>
                                <TextBlock Grid.Row="6" Text="Особливості" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource ValueStyle}">
                                    <Run Text="цінність" /> <Run Text="{Binding Order.DeclaredValue, Mode=OneWay}" /><Run Text="{Binding FragileText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Grid.Row="7" Text="Коментар" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Order.Comment, TargetNullValue='—'}" Style="{StaticResource ValueStyle}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardStyle}" AutomationProperties.Name="Вартість">
                            <StackPanel>
                                <TextBlock Text="Вартість (знімок на момент оформлення)" Style="{StaticResource CardTitleStyle}" />
                                <ItemsControl ItemsSource="{Binding PriceLines}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type orders:PriceLine}">
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Amount}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Separator Margin="0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Разом" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Grid.Column="1" Text="{Binding Order.Price}" FontWeight="SemiBold" FontSize="16" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" AutomationProperties.Name="Оплата">
                            <StackPanel>
                                <TextBlock Text="Оплата й кур'єр" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Style="{StaticResource ValueStyle}">
                                    <Run Text="Платник:" /> <Run Text="{Binding Order.Payment.Payer, Mode=OneWay, Converter={StaticResource EnumDisplay}}" />,
                                    <Run Text="{Binding Order.Payment.Method, Mode=OneWay, Converter={StaticResource EnumDisplay}}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource ValueStyle}">
                                    <Run Text="Стан:" /> <Run Text="{Binding Order.Payment.Status, Mode=OneWay, Converter={StaticResource EnumDisplay}}" FontWeight="SemiBold" />
                                    <Run Text="{Binding PaymentDetails, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource ValueStyle}">
                                    <Run Text="Кур'єр:" /> <Run Text="{Binding Order.Courier.User.FullName, Mode=OneWay, TargetNullValue='ще не призначено', FallbackValue='ще не призначено'}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource ValueStyle}"
                                           Visibility="{Binding Order.CourierPayout, Converter={StaticResource VisibleWhen}}">
                                    <Run Text="Нарахування кур'єру:" /> <Run Text="{Binding Order.CourierPayout, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Історія статусів" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,6" />
                <DataGrid ItemsSource="{Binding History}" Style="{StaticResource DirectoryGridStyle}"
                          RowStyle="{StaticResource {x:Type DataGridRow}}" MaxHeight="220"
                          AutomationProperties.Name="Історія статусів">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Коли" Binding="{Binding ChangedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="Auto" />
                        <DataGridTextColumn Header="Зміна" Binding="{Binding Change}" Width="Auto" />
                        <DataGridTextColumn Header="Хто" Binding="{Binding ChangedBy}" Width="Auto" />
                        <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
