<UserControl x:Class="CourierService.App.Views.Directories.UserEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:CourierService.App.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dir="clr-namespace:CourierService.App.ViewModels.Directories"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dir:UserEditorViewModel}">
    <StackPanel>
        <TextBlock Text="ПІБ" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                 Style="{StaticResource FormTextBoxStyle}" b:Hint.Text="Прізвище та ім'я" AutomationProperties.Name="ПІБ" />

        <TextBlock Text="Логін" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"
                 Style="{StaticResource FormTextBoxStyle}" b:Hint.Text="латиницею, наприклад operator2" b:InputMask.Kind="Login" AutomationProperties.Name="Логін" />

        <TextBlock Text="Роль" Style="{StaticResource FieldLabelStyle}" />
        <TextBlock Text="{Binding RoleHint}" Style="{StaticResource HintTextStyle}" />
        <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Display" SelectedValuePath="Value"
                  SelectedValue="{Binding Role}" IsEnabled="{Binding IsRoleEditable}"
                  Style="{StaticResource FormComboBoxStyle}" AutomationProperties.Name="Роль" />

        <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource FieldLabelStyle}" />
        <PasswordBox x:Name="PasswordBox" MaxLength="100" PasswordChanged="OnPasswordChanged"
                     AutomationProperties.Name="Пароль" />
        <TextBlock Text="{Binding PasswordError}" Foreground="#C42B1C" FontSize="12" TextWrapping="Wrap"
                   MinHeight="16" Margin="2,2,0,8" />
    </StackPanel>
</UserControl>
