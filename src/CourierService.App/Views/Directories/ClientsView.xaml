<UserControl x:Class="CourierService.App.Views.Directories.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dir="clr-namespace:CourierService.App.ViewModels.Directories"
             xmlns:local="clr-namespace:CourierService.App.Views.Directories"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dir:ClientsViewModel}">
    <DockPanel Margin="{StaticResource PagePadding}">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
        <local:DirectoryToolbar DockPanel.Dock="Top" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding CountText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" />

        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  Style="{StaticResource DirectoryGridStyle}">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Назва / ПІБ" Binding="{Binding Name}" Width="1.6*" MinWidth="220" />
                <DataGridTextColumn Header="Тип" Binding="{Binding ClientType, Converter={StaticResource EnumDisplay}}" Width="Auto" MinWidth="140" />
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone, Converter={StaticResource Phone}}" Width="Auto" MinWidth="150" />
                <DataGridTextColumn Header="Пошта" Binding="{Binding Email}" Width="1.2*" MinWidth="180" />
                <DataGridTextColumn Header="Адреса" Binding="{Binding Address}" Width="1.2*" MinWidth="200" />
                <DataGridTextColumn Header="Район" Binding="{Binding DefaultZone.Name, TargetNullValue=—}" Width="Auto" />
                <DataGridTextColumn Header="Активний" Binding="{Binding IsActive, Converter={StaticResource YesNo}}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
