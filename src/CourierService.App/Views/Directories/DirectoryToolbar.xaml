<UserControl x:Class="CourierService.App.Views.Directories.DirectoryToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:CourierService.App.Behaviors">
    <!-- Спільна панель усіх довідників. Прив'язки — до властивостей ReferenceListViewModel<TItem>,
         тому панель працює з будь-яким довідником без додаткового коду. -->
    <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Label Grid.Column="0" Content="_Пошук:" Target="{Binding ElementName=SearchBox}"
               VerticalAlignment="Center" Padding="0,0,8,0" />
        <TextBox x:Name="SearchBox" Grid.Column="1"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Пошук за назвою, телефоном або іншими полями"
                 b:Hint.Text="Почніть вводити для пошуку" AutomationProperties.Name="Пошук" />
        <CheckBox Grid.Column="2" Content="Показувати неактивні" Margin="16,0,0,0"
                  VerticalAlignment="Center"
                  IsChecked="{Binding ShowInactive}" />

        <StackPanel Grid.Column="4" Orientation="Horizontal"
                    Visibility="{Binding CanEdit, Converter={StaticResource VisibleWhen}}">
            <Button Content="_Додати" MinWidth="100" Margin="0,0,8,0" Command="{Binding AddCommand}" />
            <Button Content="_Змінити" MinWidth="100" Margin="0,0,8,0" Command="{Binding EditCommand}" />
            <Button Content="{Binding ToggleActiveText}" MinWidth="120" Command="{Binding ToggleActiveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
