<UserControl x:Class="CourierService.App.Views.Directories.CourierEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:CourierService.App.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dir="clr-namespace:CourierService.App.ViewModels.Directories"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dir:CourierEditorViewModel}">
    <StackPanel>
        <TextBlock Text="ПІБ" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                 Style="{StaticResource FormTextBoxStyle}" b:Hint.Text="Прізвище та ім'я" AutomationProperties.Name="ПІБ" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Логін" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"
                         Style="{StaticResource FormTextBoxStyle}" b:Hint.Text="латиницею, наприклад courier5" b:InputMask.Kind="Login" AutomationProperties.Name="Логін" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Телефон" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="25"
                         Style="{StaticResource FormTextBoxStyle}" b:Hint.Text="050 123 45 67" b:InputMask.Kind="Phone" AutomationProperties.Name="Телефон" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource FieldLabelStyle}" />
        <PasswordBox x:Name="PasswordBox" MaxLength="100" PasswordChanged="OnPasswordChanged"
                     AutomationProperties.Name="Пароль" />
        <!-- PasswordBox не показує помилки прив'язки, тому текст помилки — окремим рядком -->
        <TextBlock Text="{Binding PasswordError}" Foreground="#C42B1C" FontSize="12" TextWrapping="Wrap"
                   MinHeight="16" Margin="2,2,0,8" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Транспорт" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding TransportTypes}" DisplayMemberPath="Display" SelectedValuePath="Value"
                          SelectedValue="{Binding TransportType}" Style="{StaticResource FormComboBoxStyle}" AutomationProperties.Name="Транспорт" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Вантажопідйомність, кг" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding MaxWeightGrams, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}" b:InputMask.Kind="Decimal" AutomationProperties.Name="Вантажопідйомність" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Домашня зона" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Zones}" DisplayMemberPath="Display" SelectedValuePath="Value"
                          SelectedValue="{Binding HomeZoneId}" Style="{StaticResource FormComboBoxStyle}" b:Hint.Text="Оберіть зону" AutomationProperties.Name="Домашня зона" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Виплата кур'єру, % від вартості" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding PayoutPercent, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}" b:InputMask.Kind="Integer" AutomationProperties.Name="Відсоток виплати" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
