<UserControl x:Class="CourierService.App.Views.Directories.ZoneEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dir="clr-namespace:CourierService.App.ViewModels.Directories"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dir:ZoneEditorViewModel}">
    <StackPanel>
        <TextBlock Text="Назва району" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"
                 Style="{StaticResource FormTextBoxStyle}" AutomationProperties.Name="Назва району" />

        <TextBlock Text="Берег Дніпра" Style="{StaticResource FieldLabelStyle}" />
        <ComboBox ItemsSource="{Binding Banks}" DisplayMemberPath="Display" SelectedValuePath="Value"
                  SelectedValue="{Binding Bank}" Style="{StaticResource FormComboBoxStyle}" AutomationProperties.Name="Берег" />

        <TextBlock Text="Коефіцієнт (від 1,00 до 3,00)" Style="{StaticResource FieldLabelStyle}" />
        <TextBlock Style="{StaticResource HintTextStyle}"
                   Text="1,00 — центр міста; що далі район від центру, то більший коефіцієнт." />
        <TextBox Text="{Binding CoefficientPercent, UpdateSourceTrigger=PropertyChanged}" MaxLength="6"
                 Style="{StaticResource FormTextBoxStyle}" AutomationProperties.Name="Коефіцієнт" />
    </StackPanel>
</UserControl>
