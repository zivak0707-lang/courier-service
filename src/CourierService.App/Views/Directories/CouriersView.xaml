<UserControl x:Class="CourierService.App.Views.Directories.CouriersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dir="clr-namespace:CourierService.App.ViewModels.Directories"
             xmlns:local="clr-namespace:CourierService.App.Views.Directories"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dir:CouriersViewModel}">
    <DockPanel Margin="{StaticResource PagePadding}">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SecondaryTextStyle}" Margin="0,-8,0,12"
                   Text="Кожен кур'єр має обліковий запис для входу. Деактивований кур'єр не може увійти в програму." />
        <local:DirectoryToolbar DockPanel.Dock="Top" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding CountText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" />

        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  Style="{StaticResource DirectoryGridStyle}">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ПІБ" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="Логін" Binding="{Binding Login}" Width="Auto" />
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone, Converter={StaticResource Phone}}" Width="Auto" />
                <DataGridTextColumn Header="Транспорт" Binding="{Binding TransportType, Converter={StaticResource EnumDisplay}}" Width="Auto" />
                <DataGridTextColumn Header="Вантаж до" Binding="{Binding MaxWeightGrams, Converter={StaticResource Kilograms}}" Width="Auto" />
                <DataGridTextColumn Header="Домашня зона" Binding="{Binding HomeZoneName}" Width="Auto" />
                <DataGridTextColumn Header="Виплата, %" Binding="{Binding PayoutPercent}" Width="Auto" />
                <DataGridTextColumn Header="Активний" Binding="{Binding IsActive, Converter={StaticResource YesNo}}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
