<Window x:Class="CourierService.App.Views.EditDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dir="clr-namespace:CourierService.App.ViewModels.Directories"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=dir:EditViewModelBase}"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" MaxHeight="820"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!-- Одне вікно для всіх довідників: поля форми обирає DataTemplate за типом ViewModel (App.xaml) -->
    <DockPanel Margin="28,20,28,20">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding GeneralError}"
                       Visibility="{Binding GeneralError, Converter={StaticResource VisibleWhen}}"
                       Style="{StaticResource ErrorTextStyle}"
                       Margin="0,4,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="_Зберегти" IsDefault="True" MinWidth="110" Margin="0,0,8,0"
                        Command="{Binding SaveCommand}" />
                <Button Content="_Скасувати" IsCancel="True" MinWidth="110" />
            </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" FontSize="22" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding}" Focusable="False" IsTabStop="False" />
        </ScrollViewer>
    </DockPanel>
</Window>
