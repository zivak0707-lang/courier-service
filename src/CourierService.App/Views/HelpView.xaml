<UserControl x:Class="CourierService.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:CourierService.App.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CourierService.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HelpViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />

        <!-- Зміст і пошук -->
        <DockPanel Grid.Row="1">
            <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     b:Hint.Text="Пошук у довідці" AutomationProperties.Name="Пошук у довідці"
                     ToolTip="Пошук за словом у заголовках і текстах розділів" />
            <TextBlock DockPanel.Dock="Top" Text="Нічого не знайдено." Style="{StaticResource SecondaryTextStyle}"
                       Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />
            <ListBox x:Name="TopicList" ItemsSource="{Binding FilteredTopics}" SelectedItem="{Binding SelectedTopic}"
                     SelectionChanged="OnTopicSelectionChanged" Loaded="OnTopicListLoaded"
                     DisplayMemberPath="Heading" AutomationProperties.Name="Зміст довідки"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </DockPanel>

        <!-- Текст обраного розділу -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" DataContext="{Binding SelectedTopic}">
                <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Text}" Style="{StaticResource BodyTextStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
