<Project>
  <!-- Спільні налаштування для всіх проєктів solution -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Збірка без попереджень: будь-яке попередження зупиняє збірку -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- XML-документація обов'язкова для публічних членів (CS1591 стає помилкою) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SatelliteResourceLanguages>uk</SatelliteResourceLanguages>

    <Product>Кур'єрська служба</Product>
    <Authors>Зівак Сергій Олександрович</Authors>
    <!-- Company потрапляє в атрибут збірки й показується у вікні «Про програму» як автор -->
    <Company>$(Authors)</Company>
    <Copyright>© 2026 Зівак С. О.</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
